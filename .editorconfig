# Padrões de editor compartilhados (o Biome formata, isto alinha o editor antes disso)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Espaços no fim da linha têm significado em Markdown (quebra de linha)
trim_trailing_whitespace = false
