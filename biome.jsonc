{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "root": true,

  "extends": ["@bigbrain-maestro/config-biome/react"],

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "includes": ["**", "!**/CHANGELOG.md", "!pnpm-lock.yaml"]
  }
}
