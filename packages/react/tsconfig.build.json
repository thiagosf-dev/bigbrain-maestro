{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@bigbrain-maestro/config-typescript/react.json",
    "@bigbrain-maestro/config-typescript/library.json"
  ],
  "compilerOptions": {
    "customConditions": ["@bigbrain-maestro/source"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx"]
}
